---
import BaseLayout from "./BaseLayout.astro";
import PageShell from "../components/PageShell.astro";

interface Props {
  title: string;
  summary: string;
}

const { title, summary } = Astro.props;
---

<BaseLayout title={title} description={summary}>
  <PageShell pageClass="provisional-page" mainClass="provisional-main">
      <p class="provisional-kicker">RUTA PROVISIONAL · DISEÑO PENDIENTE</p>
      <h1>{title}</h1>
      <p class="provisional-summary">{summary}</p>
      <div class="provisional-content">
        <slot />
      </div>
  </PageShell>
</BaseLayout>
