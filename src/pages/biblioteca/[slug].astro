---
import { getCollection, render, type CollectionEntry } from "astro:content";
import ProvisionalLayout from "../../layouts/ProvisionalLayout.astro";

export async function getStaticPaths() {
  const entries = (await getCollection("biblioteca")).filter(
    (entry) => !entry.data.draft && entry.data.language === "es",
  );

  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<"biblioteca">;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<ProvisionalLayout title={entry.data.title} summary={entry.data.summary}>
  <p class="entry-meta">
    <span>{entry.data.creator}</span>
    <span>{entry.data.type}</span>
  </p>
  <p><a href={entry.data.externalUrl} rel="external">Referencia externa ↗</a></p>
  {
    entry.data.commentary && (
      <section aria-labelledby="comentario-title">
        <h2 id="comentario-title">Comentario</h2>
        <p>{entry.data.commentary}</p>
      </section>
    )
  }
  <article class="provisional-entry">
    <Content />
  </article>
</ProvisionalLayout>
