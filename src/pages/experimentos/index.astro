---
import { getCollection } from "astro:content";
import ProvisionalLayout from "../../layouts/ProvisionalLayout.astro";

const experiments = (await getCollection("experimentos"))
  .filter((entry) => !entry.data.draft && entry.data.language === "es")
  .sort((a, b) => a.data.displayOrder - b.data.displayOrder);
---

<ProvisionalLayout
  title="Experimentos"
  summary="Índice provisional; las tarjetas y sus enlaces se diseñarán en una fase posterior."
>
  {
    experiments.length > 0 ? (
      <ul class="provisional-list">
        {experiments.map((experiment) => <li>{experiment.data.title}</li>)}
      </ul>
    ) : (
      <p>No hay experimentos publicados todavía.</p>
    )
  }
</ProvisionalLayout>
