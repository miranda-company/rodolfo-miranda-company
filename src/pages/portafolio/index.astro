---
import PageShell from "../../components/PageShell.astro"
import PortfolioSection from "../../components/PortfolioSection.astro"
import BaseLayout from "../../layouts/BaseLayout.astro"
import { getVisibleSpanishProjects } from "../../lib/portfolio"
import "../../styles/portfolio-shared.css"

const includeDrafts = import.meta.env.DEV
const projects = await getVisibleSpanishProjects(includeDrafts)
---

<BaseLayout
  title="Portafolio"
  description="Selección curada de proyectos de Rodolfo Miranda Company."
  canonicalPath="/portafolio"
  socialImage={projects[0]?.data.coverImage}
  socialImageAlt={projects[0]?.data.coverAlt}
  schemaType="CollectionPage"
>
  <PageShell pageClass="portfolio-page" mainClass="portfolio-main page-main--with-back">
    <a class="page-back" href="/">← Volver al inicio</a>
    <PortfolioSection
      projects={projects}
      includeDrafts={includeDrafts}
      headingLevel="h1"
      eyebrow="Trabajo seleccionado de Rodolfo Miranda"
    />
  </PageShell>
</BaseLayout>
