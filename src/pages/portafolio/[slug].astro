---
import { getCollection, type CollectionEntry } from "astro:content";
import PortfolioProject from "../../components/PortfolioProject.astro";

export async function getStaticPaths() {
  const includeDrafts = import.meta.env.DEV;
  const entries = (await getCollection("portafolio"))
    .filter(
      (entry) =>
        entry.id !== "_template" &&
        (includeDrafts || !entry.data.draft) &&
        entry.data.language === "es",
    )
    .sort((first, second) => first.data.displayOrder - second.data.displayOrder);

  return entries.map((entry, index) => ({
    params: { slug: entry.id },
    props: {
      entry,
      previousProject: entries[index - 1],
      nextProject: entries[index + 1],
    },
  }));
}

interface Props {
  entry: CollectionEntry<"portafolio">;
  previousProject?: CollectionEntry<"portafolio">;
  nextProject?: CollectionEntry<"portafolio">;
}

const { entry, previousProject, nextProject } = Astro.props;
---

<PortfolioProject entry={entry} previousProject={previousProject} nextProject={nextProject} />
