---
import type { CollectionEntry } from "astro:content";
import NoteArticle from "../../components/NoteArticle.astro";
import {
  getDevelopmentSpanishNoteFixtures,
  getVisibleSpanishNotes,
} from "../../lib/notes";

export async function getStaticPaths() {
  const entries = await getVisibleSpanishNotes(import.meta.env.DEV);

  const editorialPaths = entries.map((entry, index) => ({
    params: { slug: entry.id },
    props: {
      entry,
      previousNote: entries[(index - 1 + entries.length) % entries.length]!,
      nextNote: entries[(index + 1) % entries.length]!,
    },
  }));

  if (!import.meta.env.DEV) return editorialPaths;

  const fixtures = await getDevelopmentSpanishNoteFixtures();
  const fixturePaths = fixtures.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));

  return [...editorialPaths, ...fixturePaths];
}

interface Props {
  entry: CollectionEntry<"notas">;
  previousNote?: CollectionEntry<"notas">;
  nextNote?: CollectionEntry<"notas">;
}

const { entry, previousNote, nextNote } = Astro.props;
---

<NoteArticle entry={entry} previousNote={previousNote} nextNote={nextNote} />
