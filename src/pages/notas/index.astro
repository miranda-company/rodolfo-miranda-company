---
import NoteCard from "../../components/NoteCard.astro"
import PageShell from "../../components/PageShell.astro"
import BaseLayout from "../../layouts/BaseLayout.astro"
import { formatDottedDate } from "../../lib/dates"
import { getVisibleSpanishNotes } from "../../lib/notes"
import "../../styles/notes-index.css"
import "../../styles/notes-shared.css"

const includeDrafts = import.meta.env.DEV
const notes = await getVisibleSpanishNotes(includeDrafts)
const latestUpdatedAt = notes[0]?.data.updatedAt
const noteCountLabel = `${notes.length} ${notes.length === 1 ? "nota" : "notas"}`
---

<BaseLayout
  title="Notas"
  description="Ideas en proceso, conexiones y apuntes que cambian con el tiempo."
>
  <PageShell pageClass="notes-page" mainClass="notes-main page-main--with-back">
    <a class="page-back" href="/#indice">← Volver al índice</a>
    <section class="page-intro notes-intro" aria-labelledby="notes-title">
      <div class="notes-intro__copy">
        <p class="kicker notes-kicker">Ideas y pensamientos</p>
        <h1 id="notes-title">Notas</h1>
        <p class="notes-intro__description">
          Ideas en proceso, conexiones y apuntes que cambian con el tiempo.
        </p>
        <p class="notes-intro__meta">
          {noteCountLabel} · {
            latestUpdatedAt
              ? `Actualizado ${formatDottedDate(latestUpdatedAt)}`
              : "Sin actualizaciones"
          }
        </p>
      </div>
      <div class="notes-intro__graph" aria-hidden="true">
        <span class="intro-node intro-node--a"></span>
        <span class="intro-node intro-node--b"></span>
        <span class="intro-node intro-node--c"></span>
        <span class="intro-node intro-node--d"></span>
        <i class="intro-line intro-line--a"></i>
        <i class="intro-line intro-line--b"></i>
        <i class="intro-line intro-line--c"></i>
        <b>02.27 / CAMPO ABIERTO</b>
      </div>
    </section>

    <details class="note-controls-disclosure" data-note-disclosure>
      <summary>
        <span>Filtrar y ordenar</span>
        <span data-filter-summary>{notes.length} notas · sin filtros</span>
      </summary>

      <form class="note-controls" data-note-controls>
        <fieldset class="note-filter-group">
          <legend>Madurez</legend>
          <div class="note-filter-options">
            <button class="archive-control" type="button" aria-pressed="true" data-maturity="all">
              <span aria-hidden="true">×</span>Todas
            </button>
            <button
              class="archive-control"
              type="button"
              aria-pressed="false"
              data-maturity="semilla"
            >
              <span class="control-symbol control-symbol--seed" aria-hidden="true"></span>Semilla
            </button>
            <button
              class="archive-control"
              type="button"
              aria-pressed="false"
              data-maturity="en-crecimiento"
            >
              <span class="control-symbol control-symbol--growth" aria-hidden="true"></span>En
              crecimiento
            </button>
            <button
              class="archive-control"
              type="button"
              aria-pressed="false"
              data-maturity="perenne"
            >
              <span class="control-symbol control-symbol--perennial" aria-hidden="true"
                ><i></i></span
              >
              Perenne
            </button>
          </div>
        </fieldset>

        <fieldset class="note-filter-group note-filter-group--themes">
          <legend>Tema</legend>
          <div class="note-filter-options">
            {
              ["Estrategia", "Diseño", "Sistemas", "Cultura digital", "Herramientas"].map(
                (theme) => (
                  <button
                    class="archive-control"
                    type="button"
                    aria-pressed="false"
                    data-theme={theme}
                  >
                    <span aria-hidden="true">+</span>
                    {theme}
                  </button>
                ),
              )
            }
          </div>
        </fieldset>

        <label class="note-sort">
          <span>Orden</span>
          <select class="archive-control" data-note-sort>
            <option value="recent">Actualizadas recientemente</option>
            <option value="oldest">Más antiguas</option>
            <option value="alpha">Alfabético</option>
          </select>
        </label>
      </form>
    </details>

    <div class="notes-results-line">
      <span data-result-count aria-live="polite">{notes.length} notas visibles</span>
    </div>

    <section class="note-garden" aria-label="Jardín de notas" data-note-garden>
      {notes.map((entry) => <NoteCard entry={entry} />)}
    </section>

    <div class="note-empty" data-note-empty hidden>
      <p>No hay notas que coincidan con esta combinación. Prueba otro cruce.</p>
      <button class="filter-reset" type="button" data-note-reset>Restablecer filtros</button>
    </div>
  </PageShell>

  <script>
    const disclosure = document.querySelector<HTMLDetailsElement>("[data-note-disclosure]")
    const mobileDisclosure = window.matchMedia("(max-width: 767px)")

    if (disclosure && disclosure.dataset.viewportReady !== "true") {
      disclosure.dataset.viewportReady = "true"
      const syncDisclosure = () => {
        disclosure.toggleAttribute("open", !mobileDisclosure.matches)
      }

      syncDisclosure()
      mobileDisclosure.addEventListener("change", syncDisclosure)
    }

    const controls = document.querySelector<HTMLElement>("[data-note-controls]")
    const garden = document.querySelector<HTMLElement>("[data-note-garden]")

    if (controls && garden && controls.dataset.ready !== "true") {
      controls.dataset.ready = "true"

      const maturityButtons = Array.from(
        controls.querySelectorAll<HTMLButtonElement>("[data-maturity]"),
      )
      const themeButtons = Array.from(controls.querySelectorAll<HTMLButtonElement>("[data-theme]"))
      const sortControl = controls.querySelector<HTMLSelectElement>("[data-note-sort]")
      const count = document.querySelector<HTMLElement>("[data-result-count]")
      const filterSummary = document.querySelector<HTMLElement>("[data-filter-summary]")
      const empty = document.querySelector<HTMLElement>("[data-note-empty]")
      const reset = document.querySelector<HTMLButtonElement>("[data-note-reset]")
      const cards = Array.from(garden.querySelectorAll<HTMLElement>("[data-note-card]"))

      let maturity = "all"
      let theme = ""

      const applyGardenState = () => {
        const sortedCards = [...cards].sort((first, second) => {
          if (sortControl?.value === "alpha") {
            return (first.dataset.title ?? "").localeCompare(second.dataset.title ?? "", "es")
          }

          const direction = sortControl?.value === "oldest" ? 1 : -1
          const dateDifference =
            direction * (first.dataset.updated ?? "").localeCompare(second.dataset.updated ?? "")
          return (
            dateDifference ||
            (first.dataset.archive ?? "").localeCompare(second.dataset.archive ?? "", "es")
          )
        })

        let visible = 0
        sortedCards.forEach((card) => {
          const matchesMaturity = maturity === "all" || card.dataset.state === maturity
          const matchesTheme = !theme || (card.dataset.tags ?? "").split("|").includes(theme)
          card.hidden = !(matchesMaturity && matchesTheme)
          if (!card.hidden) visible += 1
          garden.append(card)
        })

        const resultLabel = `${visible} ${visible === 1 ? "nota visible" : "notas visibles"}`
        const filtersActive = maturity !== "all" || Boolean(theme)
        if (count) count.textContent = resultLabel
        if (filterSummary) {
          filterSummary.textContent = `${visible} ${visible === 1 ? "nota" : "notas"} · ${
            filtersActive ? "filtros activos" : "sin filtros"
          }`
        }
        if (empty) empty.hidden = visible !== 0
      }

      maturityButtons.forEach((button) => {
        button.addEventListener("click", () => {
          maturity = button.dataset.maturity ?? "all"
          maturityButtons.forEach((candidate) => {
            candidate.setAttribute("aria-pressed", String(candidate === button))
          })
          applyGardenState()
        })
      })

      themeButtons.forEach((button) => {
        button.addEventListener("click", () => {
          const nextTheme = button.dataset.theme ?? ""
          theme = theme === nextTheme ? "" : nextTheme
          themeButtons.forEach((candidate) => {
            candidate.setAttribute("aria-pressed", String(candidate.dataset.theme === theme))
          })
          applyGardenState()
        })
      })

      reset?.addEventListener("click", () => {
        maturity = "all"
        theme = ""
        maturityButtons.forEach((button) => {
          button.setAttribute("aria-pressed", String(button.dataset.maturity === "all"))
        })
        themeButtons.forEach((button) => button.setAttribute("aria-pressed", "false"))
        applyGardenState()
      })

      sortControl?.addEventListener("change", applyGardenState)
    }
  </script>
</BaseLayout>
