---
import type { CollectionEntry } from "astro:content";
import MediaReference from "../../components/MediaReference.astro";
import {
  getDevelopmentSpanishMediaFixtures,
  getVisibleSpanishMedia,
} from "../../lib/media";

export async function getStaticPaths() {
  const entries = await getVisibleSpanishMedia(import.meta.env.DEV);
  const editorialPaths = entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));

  if (!import.meta.env.DEV) return editorialPaths;

  const fixtures = await getDevelopmentSpanishMediaFixtures();
  return [
    ...editorialPaths,
    ...fixtures.map((entry) => ({
      params: { slug: entry.id },
      props: { entry },
    })),
  ];
}

interface Props {
  entry: CollectionEntry<"mediateca">;
}

const { entry } = Astro.props;
---

<MediaReference entry={entry} />
