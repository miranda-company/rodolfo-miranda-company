---
import { getEntry } from "astro:content";
import ArchiveCard from "../components/ArchiveCard.astro";
import LatestMedia from "../components/LatestMedia.astro";
import LatestNotes from "../components/LatestNotes.astro";
import PageShell from "../components/PageShell.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getVisibleSpanishMedia } from "../lib/media";
import { formatNoteDate, getVisibleSpanishNotes } from "../lib/notes";

const home = await getEntry("homepage", "homepage");
const ahora = await getEntry("ahora", "ahora");

if (!home || !ahora) {
  throw new Error("Falta el contenido validado de la portada.");
}

const publishedNotes = await getVisibleSpanishNotes(false);
const publishedMedia = await getVisibleSpanishMedia(false);
const latestPublishedNote = [...publishedNotes].sort(
  (a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime(),
)[0];

const panels = home.data.panels.map((panel) => {
  if (panel.kind === "notas") {
    return {
      ...panel,
      metadata: `Última nota · ${latestPublishedNote ? formatNoteDate(latestPublishedNote.data.publishedAt) : "—"}`,
      reveal: `${publishedNotes.length} ${publishedNotes.length === 1 ? "nota publicada" : "notas publicadas"}`,
    };
  }

  if (panel.kind === "mediateca") {
    return {
      ...panel,
      reveal: `${publishedMedia.length} ${publishedMedia.length === 1 ? "medio guardado" : "medios guardados"}`,
    };
  }

  return panel;
});

const notes = publishedNotes
  .filter((entry) => entry.data.featured)
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime())
  .slice(0, 3);

const bookOrder = ["modulor", "cosas", "orden"];
const mediaShelf = publishedMedia
  .filter((entry) => entry.data.featured)
  .sort((a, b) => bookOrder.indexOf(a.id) - bookOrder.indexOf(b.id))
  .slice(0, 3);
---

<BaseLayout>
  <PageShell pageClass="home-page" mainClass="home-main">
    <section class="hero" id="inicio" aria-labelledby="hero-title">
      <div class="hero-grid">
        <h1 id="hero-title">{home.data.heroTitle[0]}<br />{home.data.heroTitle[1]}</h1>
        <p class="positioning">{home.data.positioning}</p>
      </div>
      <div class="connection"><span>{home.data.connectionLabel}</span></div>
    </section>

    <section class="panel-section" id="indice" aria-label="Archivo principal">
      <div class="section-label">
        <span>{home.data.indexLabel}</span>
      </div>
      <div class="panels">
        {panels.map((panel) => <ArchiveCard panel={panel} />)}
      </div>
    </section>

    <section class="growing-section" id="ahora" aria-labelledby="growing-title">
      <div class="section-label">
        <span>{ahora.data.label}</span>
        <span>{ahora.data.period}</span>
      </div>
      <h2 id="growing-title">{ahora.data.title}</h2>
      <div class="growing-grid">
        <div class="preview-column">
          <h3>{ahora.data.notesHeading}</h3>
          <LatestNotes entries={notes} />
          <a class="archive-link" href="/notas">{ahora.data.notesLinkLabel}</a>
        </div>
        <div class="preview-column">
          <h3>{ahora.data.mediatecaHeading}</h3>
          <LatestMedia entries={mediaShelf} />
          <a class="archive-link" href="/mediateca">{ahora.data.mediatecaLinkLabel}</a>
        </div>
        <div class="preview-column process-preview">
          <h3>{ahora.data.processHeading}</h3>
          <div class="process-field">
            <span>{ahora.data.processIndex}</span>
            <i></i>
            <b>{ahora.data.processTitle[0]}<br />{ahora.data.processTitle[1]}</b>
            <em>{ahora.data.processStatus}</em>
          </div>
          <a class="archive-link" href="/experimentos">{ahora.data.processLinkLabel}</a>
        </div>
      </div>
    </section>
  </PageShell>
</BaseLayout>
