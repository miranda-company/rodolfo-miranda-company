---
import { Image } from "astro:assets"
import { getEntry } from "astro:content"
import LatestMedia from "../components/LatestMedia.astro"
import LatestNotes from "../components/LatestNotes.astro"
import PageShell from "../components/PageShell.astro"
import PortfolioSection from "../components/PortfolioSection.astro"
import PortfolioWildcard from "../components/PortfolioWildcard.astro"
import BaseLayout from "../layouts/BaseLayout.astro"
import { getVisibleSpanishMedia } from "../lib/media"
import { getVisibleSpanishNotes } from "../lib/notes"
import { getLatestProjects, getVisibleSpanishProjects } from "../lib/portfolio"
import "../styles/home.css"

import portrait from "../assets/images/retrato-rodolfo-miranda.jpg"

const home = await getEntry("homepage", "homepage")
const ahora = await getEntry("ahora", "ahora")
const profile = await getEntry("profile", "yo")

if (!home || !ahora || !profile) {
  throw new Error("Falta el contenido validado de la portada.")
}

const publishedNotes = await getVisibleSpanishNotes(false)
const publishedMedia = await getVisibleSpanishMedia(false)
const publishedProjects = await getVisibleSpanishProjects(false)
const latestProjects = getLatestProjects(publishedProjects, 6)
const notes = publishedNotes.slice(0, 3)

const mediaShelf = publishedMedia.filter((entry) => entry.data.displayInShelf).slice(0, 3)
const connectionLinkStart = home.data.connectionLabel.indexOf(home.data.connectionLink.label)
const connectionLabelBefore = home.data.connectionLabel.slice(0, connectionLinkStart)
const connectionLabelAfter = home.data.connectionLabel.slice(
  connectionLinkStart + home.data.connectionLink.label.length,
)
---

<BaseLayout canonicalPath="/" socialImage={portrait} socialImageAlt={profile.data.portrait.alt}>
  <PageShell pageClass="home-page" mainClass="home-main">
    <section class="hero" id="inicio" aria-labelledby="hero-title">
      <div class="hero-grid">
        <div class="text-container">
          <p class="kicker home-kicker">{home.data.heroEyebrow}</p>
          <h1 id="hero-title">
            <span>{home.data.heroTitle}</span>
            <em> {home.data.heroTitleAccent}</em>
          </h1>
          <p class="intro-lead home-intro__description">
            {connectionLabelBefore}<a href={home.data.connectionLink.href}
              >{home.data.connectionLink.label}</a
            >{connectionLabelAfter}
          </p>
        </div>

        <div class="img-container">
          <Image
            src={portrait}
            width={760}
            height={760}
            format="webp"
            quality={85}
            class="hero-image"
            alt={profile.data.portrait.alt}
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </div>
      </div>
    </section>

    <section class="home-portfolio" id="portfolio-reciente" aria-label="Portafolio reciente">
      <PortfolioSection
        projects={latestProjects}
        headingLevel="h2"
        titleId="home-portfolio-title"
      />
    </section>

    <section class="growing-section" id="ahora" aria-labelledby="growing-title">
      <h2 class="section-label" id="growing-title">
        <span>{ahora.data.label}</span>
      </h2>
      <div class="growing-grid">
        <div class="preview-column">
          <h3>{ahora.data.notesHeading}</h3>
          <LatestNotes entries={notes} />
          <a class="archive-link" href="/notas">{ahora.data.notesLinkLabel}</a>
        </div>
        <div class="preview-column">
          <h3>{ahora.data.mediatecaHeading}</h3>
          <LatestMedia entries={mediaShelf} />
          <a class="archive-link" href="/mediateca">{ahora.data.mediatecaLinkLabel}</a>
        </div>
        <div class="preview-column portfolio-preview">
          <h3>{ahora.data.portfolioHeading}</h3>
          <PortfolioWildcard
            entries={publishedProjects}
            emptyTitle={ahora.data.portfolioEmptyTitle}
            emptyStatus={ahora.data.portfolioEmptyStatus}
          />
          <a class="archive-link" href="/portafolio">{ahora.data.portfolioLinkLabel}</a>
        </div>
      </div>
    </section>
  </PageShell>
</BaseLayout>
