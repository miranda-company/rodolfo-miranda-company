---
import { getEntry } from "astro:content";
import ArchiveCard from "../components/ArchiveCard.astro";
import LatestMedia from "../components/LatestMedia.astro";
import LatestNotes from "../components/LatestNotes.astro";
import PageShell from "../components/PageShell.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getVisibleSpanishMedia } from "../lib/media";
import { formatNoteDate, getVisibleSpanishNotes } from "../lib/notes";
import { getVisibleSpanishProjects } from "../lib/portfolio";

import { Image } from "astro:assets";
import helloComputer from "../assets/images/homepage/hello-computer-002.png";

const home = await getEntry("homepage", "homepage");
const ahora = await getEntry("ahora", "ahora");

if (!home || !ahora) {
  throw new Error("Falta el contenido validado de la portada.");
}

const publishedNotes = await getVisibleSpanishNotes(false);
const publishedMedia = await getVisibleSpanishMedia(false);
const publishedProjects = await getVisibleSpanishProjects(false);
const visibleProjects = import.meta.env.DEV
  ? await getVisibleSpanishProjects(true)
  : publishedProjects;
const latestPublishedNote = [...publishedNotes].sort(
  (a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime(),
)[0];
const latestPortfolioProject = [...visibleProjects].sort(
  (a, b) => b.data.updatedAt.getTime() - a.data.updatedAt.getTime(),
)[0];

const panels = home.data.panels.map((panel) => {
  if (panel.kind === "notas") {
    return {
      ...panel,
      metadata: `Última nota · ${latestPublishedNote ? formatNoteDate(latestPublishedNote.data.publishedAt) : "—"}`,
      reveal: `${publishedNotes.length} ${publishedNotes.length === 1 ? "nota publicada" : "notas publicadas"}`,
    };
  }

  if (panel.kind === "mediateca") {
    return {
      ...panel,
      reveal: `${publishedMedia.length} ${publishedMedia.length === 1 ? "medio guardado" : "medios guardados"}`,
    };
  }

  if (panel.kind === "portafolio") {
    return {
      ...panel,
      reveal: `${publishedProjects.length} ${publishedProjects.length === 1 ? "proyecto publicado" : "proyectos publicados"}`,
    };
  }

  return panel;
});

const notes = publishedNotes
  .filter((entry) => entry.data.featured)
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime())
  .slice(0, 3);

const bookOrder = ["modulor", "cosas", "orden"];
const mediaShelf = publishedMedia
  .filter((entry) => entry.data.featured)
  .sort((a, b) => bookOrder.indexOf(a.id) - bookOrder.indexOf(b.id))
  .slice(0, 3);
---

<BaseLayout>
  <PageShell pageClass="home-page" mainClass="home-main">
    
    <section class="hero" id="inicio" aria-labelledby="hero-title">
      <div class="hero-grid">
        
        <div class="text-container">
          <h1 id="hero-title">{home.data.heroTitle}</h1>
          <p>{home.data.connectionLabel}</p>
        </div>

        <div class="img-container">
          <Image src={helloComputer} class="hero-image" alt="Ilustración de un ordenador cubierto de plantas con el mensaje «Hello World!»"/>
        </div>

      </div>
    </section>

    <section class="panel-section" id="indice" aria-label="Archivo principal">
      <div class="section-label">
        <span>{home.data.indexLabel}</span>
      </div>
      <div class="panels">
        {panels.map((panel) => <ArchiveCard panel={panel} />)}
      </div>
    </section>

    <section class="growing-section" id="ahora" aria-labelledby="growing-title">
      <div class="section-label">
        <span>{ahora.data.label}</span>
        <span>{ahora.data.period}</span>
      </div>
      <h2 id="growing-title">{ahora.data.title}</h2>
      <div class="growing-grid">
        <div class="preview-column">
          <h3>{ahora.data.notesHeading}</h3>
          <LatestNotes entries={notes} />
          <a class="archive-link" href="/notas">{ahora.data.notesLinkLabel}</a>
        </div>
        <div class="preview-column">
          <h3>{ahora.data.mediatecaHeading}</h3>
          <LatestMedia entries={mediaShelf} />
          <a class="archive-link" href="/mediateca">{ahora.data.mediatecaLinkLabel}</a>
        </div>
        <div class="preview-column portfolio-preview">
          <h3>{ahora.data.portfolioHeading}</h3>
          {
            latestPortfolioProject ? (
              <a
                class="portfolio-latest"
                href={`/portafolio/${latestPortfolioProject.id}`}
                aria-label={`Abrir proyecto: ${latestPortfolioProject.data.title}`}
              >
                <span>{latestPortfolioProject.data.archiveNumber}</span>
                <b>{latestPortfolioProject.data.title}</b>
                <em>
                  {latestPortfolioProject.data.projectStatus} · ACT. {formatNoteDate(
                    latestPortfolioProject.data.updatedAt,
                  )}
                </em>
              </a>
            ) : (
              <div class="portfolio-latest portfolio-latest--empty">
                <span>P.—</span>
                <b>{ahora.data.portfolioEmptyTitle}</b>
                <em>{ahora.data.portfolioEmptyStatus}</em>
              </div>
            )
          }
          <a class="archive-link" href="/portafolio">{ahora.data.portfolioLinkLabel}</a>
        </div>
      </div>
    </section>
  </PageShell>
</BaseLayout>
