  <nav aria-label="Enlaces del pie de página">
    <ul class="site-footer__links">
      <li>
        <a
          href="https://www.linkedin.com/in/rodolfo-miranda-company/"
          target="_blank"
          rel="external noopener noreferrer"
          aria-label="LinkedIn, se abre en una pestaña nueva">LinkedIn ↗</a
        >
      </li>
      <li><a href="mailto:hi@rodolfomiranda.company">Email</a></li>
      <li>
        <span class="site-footer__pending" aria-label="Colofón, próximamente">
          Colofón <small>Próximamente</small>
        </span>
      </li>
      <li><a href="/registro" aria-current={isRegistro ? "page" : undefined}>Registro</a></li>
    </ul>
  </nav>
</footer>
