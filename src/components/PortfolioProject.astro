---
import { Image } from "astro:assets";
import { getEntries, render, type CollectionEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/portfolio.css";
import PageShell from "./PageShell.astro";
import PortfolioArtwork from "./PortfolioArtwork.astro";
import ProjectMeta from "./ProjectMeta.astro";

interface Props {
  entry: CollectionEntry<"portafolio">;
  previousProject?: CollectionEntry<"portafolio">;
  nextProject?: CollectionEntry<"portafolio">;
}

const { entry, previousProject, nextProject } = Astro.props;
const { Content } = await render(entry);
const relatedNotes = await getEntries(entry.data.relatedNotes);
const relatedMedia = await getEntries(entry.data.relatedMedia);
const hasConnections = relatedNotes.length > 0 || relatedMedia.length > 0 || entry.data.projectLinks.length > 0;
const showConnections = hasConnections || entry.data.placeholder;
const updatedLabel = new Intl.DateTimeFormat("es-ES", {
  day: "2-digit",
  month: "2-digit",
  year: "numeric",
}).format(entry.data.updatedAt);
---

<BaseLayout title={entry.data.title} description={entry.data.summary}>
  <PageShell pageClass="portfolio-page" mainClass="project-main">
      <a class="project-back" href="/portafolio">← Volver a Portafolio</a>

      <header class="project-header">
        <p>{entry.data.archiveNumber} / {entry.data.projectStatus}</p>
        <h1>{entry.data.title}</h1>
        <p>{entry.data.summary}</p>
      </header>

      <div class:list={["project-layout", { "project-layout--without-connections": !showConnections }]}>
        <ProjectMeta entry={entry} />

        <article class="project-reading">
          {
            entry.data.placeholder && (
              <p class="project-provisional-notice">
                <span aria-hidden="true">●—●</span>
                PROTOTIPO DE CONTENIDO · INFORMACIÓN DE PROYECTO PENDIENTE
              </p>
            )
          }

          <PortfolioArtwork entry={entry} />

          <div class="project-body">
            <Content />
          </div>

          {
            entry.data.gallery.length > 0 && (
              <div class="project-gallery" aria-label="Imágenes adicionales del proyecto">
                {entry.data.gallery.map((item) => (
                  <figure>
                    <Image
                      src={item.image}
                      alt={item.alt}
                      widths={[480, 720, 960, 1280]}
                      sizes="(max-width: 767px) calc(100vw - 40px), 720px"
                      loading="lazy"
                      decoding="async"
                    />
                    {item.caption && <figcaption>{item.caption}</figcaption>}
                  </figure>
                ))}
              </div>
            )
          }

          <footer class="project-article-footer">
            <p>ÚLTIMA ACTUALIZACIÓN · {updatedLabel}</p>
            <span>{entry.data.projectStatus}</span>
          </footer>
        </article>

        {
          showConnections && (
            <aside class="project-connections" aria-labelledby="project-connections-title">
              <div class="project-connections__notation" aria-hidden="true">
                <span></span><span></span><span></span><i></i><i></i>
              </div>
              <h2 id="project-connections-title">Conexiones</h2>
              {
                relatedNotes.length > 0 && (
                  <section aria-labelledby="project-notes-title">
                    <h3 id="project-notes-title">Notas relacionadas</h3>
                    <ul>{relatedNotes.map((note) => <li><a href={`/notas/${note.id}`}>{note.data.title}</a></li>)}</ul>
                  </section>
                )
              }
              {
                relatedMedia.length > 0 && (
                  <section aria-labelledby="project-media-title">
                    <h3 id="project-media-title">En la Mediateca</h3>
                    <ul>{relatedMedia.map((item) => <li><a href={`/mediateca/${item.id}`}>{item.data.title}</a></li>)}</ul>
                  </section>
                )
              }
              {
                entry.data.projectLinks.length > 0 && (
                  <section aria-labelledby="project-links-title">
                    <h3 id="project-links-title">Enlaces verificados</h3>
                    <ul>
                      {entry.data.projectLinks.map((link) => <li><a href={link.url} rel="external noreferrer">{link.label} ↗</a></li>)}
                    </ul>
                  </section>
                )
              }
              {!hasConnections && <p class="project-connections__pending">CONEXIONES PENDIENTES DE VERIFICACIÓN</p>}
            </aside>
          )
        }
      </div>

      <nav class="project-sequence" aria-label="Navegación entre proyectos">
        {
          previousProject && (
            <a class="project-sequence__previous" href={`/portafolio/${previousProject.id}`}>
              <span>← Proyecto anterior</span>{previousProject.data.title}
            </a>
          )
        }
        {
          nextProject && (
            <a class="project-sequence__next" href={`/portafolio/${nextProject.id}`}>
              <span>Proyecto siguiente →</span>{nextProject.data.title}
            </a>
          )
        }
        <a class="project-sequence__all" href="/portafolio">Volver a todos los proyectos</a>
      </nav>
  </PageShell>
</BaseLayout>
