---
import type { CollectionEntry } from "astro:content";

interface Props {
  entries: CollectionEntry<"mediateca">[];
  fragmentTargets?: boolean;
  detailLinks?: boolean;
}

const { entries, fragmentTargets = false, detailLinks = false } = Astro.props;
---

<ol class="latest-media" aria-label="Tres referencias destacadas">
  {
    entries.map((entry) => (
      <li
        id={fragmentTargets ? entry.id : undefined}
        class={fragmentTargets ? "fragment-target" : undefined}
        tabindex={fragmentTargets ? "-1" : undefined}
      >
        <a href={detailLinks ? "/mediateca/" + entry.id : "/mediateca#" + entry.id}>
          <span class:list={["book-cover", "cover-" + entry.id]} aria-hidden="true">
            {entry.id === "modulor" && <i>LE<br />MODULOR</i>}
            {entry.id === "cosas" && <i>LAS<br />COSAS</i>}
            {entry.id === "orden" && <i>EL<br />ORDEN<br />DEL<br />TIEMPO</i>}
          </span>
          <span>{entry.data.title}</span>
        </a>
      </li>
    ))
  }
</ol>
