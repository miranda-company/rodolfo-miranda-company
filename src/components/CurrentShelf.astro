---
import type { CollectionEntry } from "astro:content"
import { MEDIA_STATUS_LABELS } from "../lib/media"

interface Props {
  entries: CollectionEntry<"mediateca">[]
}

const { entries } = Astro.props
---

<ol class="current-shelf__items">
  {
    entries.map((entry) => (
      <li id={entry.id} class="current-shelf__item fragment-target" tabindex="-1">
        <a href={`/mediateca/${entry.id}`}>
          <span class:list={["shelf-cover", `shelf-cover--${entry.id}`]} aria-hidden="true">
            <i>{entry.data.archiveNumber}</i>
            {entry.id === "modulor" && (
              <b>
                LE
                <br />
                MODULOR
              </b>
            )}
            {entry.id === "cosas" && (
              <b>
                LAS
                <br />
                COSAS
              </b>
            )}
            {entry.id === "orden" && (
              <b>
                EL
                <br />
                ORDEN
                <br />
                DEL
                <br />
                TIEMPO
              </b>
            )}
            <em>{entry.data.creator}</em>
          </span>
          <span class="current-shelf__copy">
            <span>{entry.data.archiveNumber} · LIBRO</span>
            <h3>{entry.data.title}</h3>
            <small>{entry.data.creator}</small>
            <p>{entry.data.summary}</p>
            <span>{MEDIA_STATUS_LABELS[entry.data.status]} · ABRIR ↗</span>
          </span>
        </a>
      </li>
    ))
  }
</ol>
