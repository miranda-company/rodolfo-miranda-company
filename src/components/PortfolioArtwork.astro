---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";

interface Props {
  entry: CollectionEntry<"portafolio">;
  decorative?: boolean;
}

const { entry, decorative = false } = Astro.props;
const coverImage = entry.data.coverImage;
const coverAlt = decorative ? "" : (entry.data.coverAlt ?? "");
const coverCaption = decorative ? undefined : entry.data.coverCaption?.trim();
const variant = ((entry.data.displayOrder - 1) % 3) + 1;
---

{
  coverImage ? (
    <figure class="portfolio-cover">
      <Image
        class:list={["portfolio-artwork", `portfolio-artwork--${variant}`, "portfolio-artwork--cover"]}
        src={coverImage}
        alt={coverAlt}
        widths={[480, 720, 960, 1280]}
        sizes="(max-width: 767px) calc(100vw - 40px), 70ch"
        loading="lazy"
        decoding="async"
        aria-hidden={decorative ? "true" : undefined}
      />
      {coverCaption && <figcaption>{coverCaption}</figcaption>}
    </figure>
  ) : (
    <div
      class:list={["portfolio-artwork", `portfolio-artwork--${variant}`]}
      aria-hidden={decorative ? "true" : undefined}
    >
      <div
        class="portfolio-artwork__field"
        role={decorative ? undefined : "img"}
        aria-label={decorative ? undefined : `Composición geométrica provisional del archivo ${entry.data.archiveNumber}.`}
      >
        <span class="portfolio-artwork__node portfolio-artwork__node--a"></span>
        <span class="portfolio-artwork__node portfolio-artwork__node--b"></span>
        <span class="portfolio-artwork__node portfolio-artwork__node--c"></span>
        <i class="portfolio-artwork__line portfolio-artwork__line--a"></i>
        <i class="portfolio-artwork__line portfolio-artwork__line--b"></i>
        <b class="portfolio-artwork__plane portfolio-artwork__plane--a"></b>
        <b class="portfolio-artwork__plane portfolio-artwork__plane--b"></b>
        <em>PROTOTIPO / {entry.data.archiveNumber}</em>
      </div>
    </div>
  )
}
