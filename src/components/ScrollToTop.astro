---
const SCROLL_THRESHOLD = 600
---

<button
  class="scroll-to-top"
  type="button"
  aria-label="Volver arriba"
  data-scroll-to-top
  data-scroll-threshold={SCROLL_THRESHOLD}
  hidden
>
  <span aria-hidden="true">↑</span>
</button>

<script>
  document.querySelectorAll<HTMLButtonElement>("[data-scroll-to-top]").forEach((button) => {
    if (button.dataset.scrollReady === "true") return
    button.dataset.scrollReady = "true"

    const threshold = Number(button.dataset.scrollThreshold)
    if (!Number.isFinite(threshold)) return

    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)")
    let scrollFrame = 0

    const updateVisibility = () => {
      scrollFrame = 0
      button.hidden = window.scrollY <= threshold
    }

    const queueVisibilityUpdate = () => {
      if (scrollFrame) return
      scrollFrame = window.requestAnimationFrame(updateVisibility)
    }

    button.addEventListener("click", () => {
      window.scrollTo({ top: 0, behavior: reduceMotion.matches ? "auto" : "smooth" })
    })

    window.addEventListener("scroll", queueVisibilityUpdate, { passive: true })
    window.addEventListener("pageshow", queueVisibilityUpdate)
    updateVisibility()
  })
</script>
