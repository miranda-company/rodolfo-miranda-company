---
import type { CollectionEntry } from "astro:content"
import { formatDottedDate, toDateValue } from "../lib/dates"

interface Props {
  entries: CollectionEntry<"notas">[]
  fragmentTargets?: boolean
  detailLinks?: boolean
}

const { entries, fragmentTargets = false, detailLinks = false } = Astro.props
---

<ol class="latest-notes" aria-label="Últimas tres notas">
  {
    entries.map((entry) => (
      <li
        id={fragmentTargets ? entry.id : undefined}
        class={fragmentTargets ? "fragment-target" : undefined}
        tabindex={fragmentTargets ? "-1" : undefined}
      >
        <time datetime={toDateValue(entry.data.publishedAt)}>
          {formatDottedDate(entry.data.publishedAt)}
        </time>
        <a href={detailLinks ? "/notas/" + entry.id : "/notas#" + entry.id}>{entry.data.title}</a>
      </li>
    ))
  }
</ol>
