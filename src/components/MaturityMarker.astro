---
interface Props {
  state: "semilla" | "en-crecimiento" | "perenne";
}

const { state } = Astro.props;
const labels = {
  semilla: "Semilla",
  "en-crecimiento": "En crecimiento",
  perenne: "Perenne",
};
---

<span class:list={["maturity-marker", `is-${state}`]}>
  <span class="maturity-symbol" aria-hidden="true">
    <i></i>
    {state !== "semilla" && <i></i>}
    {state === "perenne" && <i></i>}
  </span>
  <span>{labels[state]}</span>
</span>
