---
import { getEntries, render, type CollectionEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { formatNoteDate, hasEditorialNoteBody, NOTE_MATURITY } from "../lib/notes";
import "../styles/notes.css";
import MaturityMarker from "./MaturityMarker.astro";
import PageShell from "./PageShell.astro";

interface Props {
  entry: CollectionEntry<"notas">;
  previousNote: CollectionEntry<"notas">;
  nextNote: CollectionEntry<"notas">;
}

const { entry, previousNote, nextNote } = Astro.props;
const { Content } = await render(entry);
const includeDrafts = import.meta.env.DEV;
const relatedNotes = (await getEntries(entry.data.relatedNotes)).filter(
  (note) =>
    (includeDrafts || !note.data.draft) && note.data.language === "es" && note.id !== entry.id,
);
const relatedLinks = entry.data.relatedLinks;
const hasConnections = relatedNotes.length > 0 || relatedLinks.length > 0;
const hasBody = hasEditorialNoteBody(entry);
const maturity = NOTE_MATURITY[entry.data.state];
const publishedDate = entry.data.publishedAt.toISOString().slice(0, 10);
const updatedDate = entry.data.updatedAt.toISOString().slice(0, 10);
---

<BaseLayout title={entry.data.title} description={entry.data.summary}>
  <PageShell pageClass="note-page" mainClass="note-main">
    <a class="note-back" href="/notas">← Volver a Notas</a>

    <header class="note-article-header">
      <div class="note-article-header__meta">
        <span>{entry.data.archiveNumber}</span>
        <MaturityMarker state={entry.data.state} />
      </div>
      <h1>{entry.data.title}</h1>
      <p>{entry.data.summary}</p>
    </header>

    <div class="note-article-layout">
      <aside class="note-meta-rail" aria-label="Metadatos de la nota">
        <dl>
          <div>
            <dt>Creada</dt>
            <dd><time datetime={publishedDate}>{formatNoteDate(entry.data.publishedAt)}</time></dd>
          </div>
          <div>
            <dt>Actualizada</dt>
            <dd><time datetime={updatedDate}>{formatNoteDate(entry.data.updatedAt)}</time></dd>
          </div>
          <div>
            <dt>Estado</dt>
            <dd>{maturity.label}</dd>
          </div>
          <div>
            <dt>Etiquetas</dt>
            <dd class="note-meta-tags">
              {entry.data.tags.map((tag) => <span>{tag}</span>)}
            </dd>
          </div>
        </dl>
      </aside>

      <article class="note-reading">
        <p class:list={["note-growth-notice", `is-${entry.data.state}`]}>
          <span aria-hidden="true">●—●</span>
          {maturity.notice}
        </p>

        <div class="note-body">
          {hasBody ? <Content /> : <p class="note-editorial-empty">Esta nota todavía no tiene desarrollo editorial.</p>}
        </div>

        <footer class="note-article-footer">
          <p>ÚLTIMA ACTUALIZACIÓN · {formatNoteDate(entry.data.updatedAt)}</p>
          <MaturityMarker state={entry.data.state} />
          <div class="note-footer-tags">{entry.data.tags.map((tag) => <span>{tag}</span>)}</div>
        </footer>
      </article>

      <aside class="note-connections" aria-labelledby="connections-title">
        <div class="connections-notation" aria-hidden="true">
          <span></span><span></span><span></span><i></i><i></i>
        </div>
        <h2 id="connections-title">Conexiones</h2>
        {
          hasConnections ? (
            <ul>
              {relatedNotes.map((note) => (
                <li><a href={`/notas/${note.id}`}>{note.data.title}</a></li>
              ))}
              {relatedLinks.map((link) => (
                <li><a href={link.href}>{link.label}</a></li>
              ))}
            </ul>
          ) : (
            <p class="note-connections__empty">Esta nota todavía no tiene conexiones.</p>
          )
        }
      </aside>
    </div>

    <nav class="note-sequence" aria-label="Navegación entre notas">
      <a
        class="note-sequence__previous"
        href={`/notas/${previousNote.id}`}
        aria-label={`Nota anterior: ${previousNote.data.title}`}
      >
        <span>← Nota anterior</span>{previousNote.data.title}
      </a>
      <a
        class="note-sequence__next"
        href={`/notas/${nextNote.id}`}
        aria-label={`Nota siguiente: ${nextNote.data.title}`}
      >
        <span>Nota siguiente →</span>{nextNote.data.title}
      </a>
      <a class="note-sequence__all" href="/notas">Volver a todas las notas</a>
    </nav>
  </PageShell>
</BaseLayout>
