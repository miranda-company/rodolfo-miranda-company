---
import type { CollectionEntry } from "astro:content"
import { formatDottedDate, toDateValue } from "../lib/dates"

interface Props {
  entry: CollectionEntry<"notas">
}

const { entry } = Astro.props
const { externalSource, externalUrl } = entry.data

if (entry.data.kind !== "external" || !externalSource || !externalUrl) {
  throw new Error("Una tarjeta externa de Notas requiere fuente y URL validadas.")
}
---

<article
  class="note-card note-card--external fragment-target"
  id={entry.id}
  tabindex="-1"
  data-note-card
  data-note-kind="external"
  data-state={entry.data.state}
  data-tags={entry.data.tags.join("|")}
  data-title={entry.data.title}
  data-updated={entry.data.updatedAt.toISOString()}
  data-archive={entry.data.archiveNumber}
>
  <a
    class="note-card__link"
    href={externalUrl}
    target="_blank"
    rel="noopener noreferrer"
    aria-label={`Abrir artículo externo: ${entry.data.title} — se abre en una pestaña nueva`}
  >
    <div class="note-card__topline">
      <span>{entry.data.archiveNumber}</span>
      <span class="note-card__external-label">Artículo externo ↗</span>
    </div>

    <h2>{entry.data.title}</h2>
    <p>{entry.data.summary}</p>

    <div class="note-card__footer">
      <span class="note-card__external-source">{externalSource}</span>
      <time class="note-card__date" datetime={toDateValue(entry.data.publishedAt)}>
        PUB. {formatDottedDate(entry.data.publishedAt)}
      </time>
      <span class="note-card__arrow" aria-hidden="true">↗</span>
    </div>
  </a>
</article>
